# Copy to .env for local runs. Never commit .env.
# At least one AI provider key is required for the chat.
OPENROUTER_API_KEY=
AI_MODEL=qwen/qwen-2.5-7b-instruct
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
ETHERSCAN_API_KEY=

# Local only (Render sets PORT itself).
PORT=3002
